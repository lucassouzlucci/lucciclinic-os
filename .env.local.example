# Lucci Clinic OS - Variáveis de Ambiente
# Copie para .env.local se desejar integrar com chaves externas em produção

# Anthropic Claude API (Copiloto Clínico)
ANTHROPIC_API_KEY=sua_chave_anthropic_aqui

# Google Gemini API
GEMINI_API_KEY=sua_chave_gemini_aqui

# Supabase (Banco de Dados PostgreSQL, Storage e Auth)
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua_chave_anonima_supabase
SUPABASE_SERVICE_ROLE_KEY=sua_chave_service_role_supabase

# Configuração da Clínica
NEXT_PUBLIC_DOCTOR_NAME="Dr. Lucas Lucci"
NEXT_PUBLIC_DOCTOR_CRM="CRM-SC 28419"
NEXT_PUBLIC_CLINIC_NAME="Lucci Clinic"
NEXT_PUBLIC_CLINIC_CITY="Balneário Camboriú, SC"
